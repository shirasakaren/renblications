# Required in production. Railway injects PORT automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/publications
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional S3-compatible media storage. Railway Buckets provide these.
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=auto

# Optional canonical origin. If omitted, request headers determine it.
SITE_URL=
